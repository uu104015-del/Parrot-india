rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && request.auth.token.email == "uu104015@gmail.com";
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Parrots collection helper
    function isValidParrot(data) {
      return data.keys().hasAll(['id', 'name', 'species', 'price'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.species is string && data.species.size() <= 100
        && data.price is number && data.price >= 0;
    }

    match /parrots/{parrotId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidParrot(incoming()) && isValidId(parrotId);
    }

    // 2. Orders collection helper
    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'firstName', 'phone', 'address', 'totalAmount'])
        && data.id is string && data.id.size() <= 128
        && data.firstName is string && data.firstName.size() <= 100
        && data.phone is string && data.phone.size() <= 50
        && data.address is string && data.address.size() <= 500
        && data.totalAmount is number && data.totalAmount >= 0;
    }

    match /orders/{orderId} {
      // Allows anyone with orderId to lookup (for track order panel)
      allow get: if isValidId(orderId);
      allow list: if isAdmin();
      allow create: if isValidOrder(incoming()) && isValidId(orderId);
      allow update, delete: if isAdmin();
    }

    // 3. Enquiries collection helper
    function isValidEnquiry(data) {
      return data.keys().hasAll(['id', 'name', 'phone'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 50;
    }

    match /enquiries/{enquiryId} {
      allow create: if isValidEnquiry(incoming()) && isValidId(enquiryId);
      allow read, update, delete: if isAdmin();
    }

    // 4. Promo codes
    function isValidPromo(data) {
      return data.keys().hasAll(['code', 'type', 'value'])
        && data.code is string && data.code.size() <= 50
        && data.type is string && data.type.size() <= 50
        && data.value is number && data.value >= 0;
    }

    match /promocodes/{code} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidPromo(incoming()) && isValidId(code);
    }
  }
}
